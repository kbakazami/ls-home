# Copier ce fichier en .env.local et renseigner les valeurs.
# Les memes variables doivent etre declarees dans Vercel (Settings > Environment Variables).

# Supabase — Settings > API du projet
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cle service_role : contourne la RLS. Serveur uniquement, ne jamais l'exposer.
SUPABASE_SERVICE_ROLE_KEY=

# Optionnel — uniquement pour l'import de secours `npm run sync`.
GOOGLE_SHEET_ID=
